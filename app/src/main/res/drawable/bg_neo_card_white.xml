<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist White Card: 20dp corners, 3.5dp black stroke, 6dp hard shadow matching settings.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Front Card Body -->
    <item
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/neo_card" />
            <stroke
                android:width="3.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
