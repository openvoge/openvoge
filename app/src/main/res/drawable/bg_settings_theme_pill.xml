<?xml version="1.0" encoding="utf-8"?>
<!-- 3-Segment Mode Pill Container: White body, 3dp black stroke, 4dp hard shadow matching settings.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Front Pill Body -->
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neo_card" />
            <stroke
                android:width="3dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
