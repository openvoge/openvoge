<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Circular Record/Stop Button: Lime fill, 3.8dp black stroke, 5.5dp hard drop shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="5.5dp"
        android:top="5.5dp">
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Front Button Body -->
    <item
        android:right="5.5dp"
        android:bottom="5.5dp">
        <shape android:shape="oval">
            <solid android:color="?attr/neoAccent" />
            <stroke
                android:width="3.8dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
