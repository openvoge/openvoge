<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Live Packet Terminal Card: #000000 body, 4.5dp hard black shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard black offset shadow -->
    <item
        android:left="4.5dp"
        android:top="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Pitch Black Terminal Body -->
    <item
        android:bottom="4.5dp"
        android:right="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
            <stroke
                android:width="2.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
