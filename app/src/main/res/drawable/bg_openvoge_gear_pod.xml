<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Gear Pod: Cream #ECE8DF with 12dp corners and 7dp hard black shadow matching image.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard black drop shadow (7dp offset to bottom-right) -->
    <item
        android:left="7dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Pod Body: Cream canvas color with 12dp corners -->
    <item
        android:bottom="7dp"
        android:right="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#ECE8DF" />
            <stroke
                android:width="2.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
