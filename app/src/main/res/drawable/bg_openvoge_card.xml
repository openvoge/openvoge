<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Card: Rounded rect with 5dp hard black offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard black drop shadow (bottom-right offset) -->
    <item
        android:left="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/border" />
        </shape>
    </item>

    <!-- Main Card Body -->
    <item
        android:bottom="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/surface_elevated" />
            <stroke
                android:width="2.5dp"
                android:color="@color/border" />
        </shape>
    </item>
</layer-list>
