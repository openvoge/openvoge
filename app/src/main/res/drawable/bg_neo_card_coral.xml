<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Connection Banner Card: Dark #111111 body, 2.5dp black stroke, 4dp hard black shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="4.5dp"
        android:top="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Dark Card Body -->
    <item
        android:bottom="4.5dp"
        android:right="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#111111" />
            <stroke
                android:width="2.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
