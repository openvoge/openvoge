<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist CONNECT button: lime fill, 2.5dp black stroke, 3dp hard shadow matching dash.png -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="?attr/neoAccent" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#000000" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="?attr/neoAccent" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
