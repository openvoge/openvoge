<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist White Tile (was coral): White fill, 4dp hard shadow, 2.5dp stroke -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/neo_card" />
            <stroke
                android:width="2.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
