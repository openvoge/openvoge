<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Telemetry Card: White fill, 3.5dp black stroke, 6.5dp hard drop shadow matching goal.png -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="6.5dp"
        android:top="6.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Front Card Body -->
    <item
        android:right="6.5dp"
        android:bottom="6.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/neo_card" />
            <stroke
                android:width="3.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
