<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Square Box Button: Lime fill, 2.5dp black stroke, 4dp hard shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow Offset to Bottom-Right -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Main Front Button Body -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="?attr/neoAccent" />
            <stroke
                android:width="2.5dp"
                android:color="#000000" />
        </shape>
    </item>
</layer-list>
