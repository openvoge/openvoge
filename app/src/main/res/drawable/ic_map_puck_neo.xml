<?xml version="1.0" encoding="utf-8"?>
<!-- "You are here" puck: accent dot, thick black ring, hard offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#000000" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="?attr/neoAccent" />
            <stroke
                android:width="3dp"
                android:color="#000000" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
</layer-list>
