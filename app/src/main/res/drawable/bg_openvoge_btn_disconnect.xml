<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist Disconnect Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/border" />
            <stroke
                android:width="2.5dp"
                android:color="@color/border" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item
                android:left="3dp"
                android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="32dp" />
                    <solid android:color="@color/border" />
                </shape>
            </item>

            <item
                android:bottom="4dp"
                android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="32dp" />
                    <solid android:color="@color/neo_coral" />
                    <stroke
                        android:width="2.5dp"
                        android:color="@color/border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
