<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel-Perfect Neo-Brutalist Settings Bottom Sheet matching settings.png -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_openvoge_bottom_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle: 38x5dp black rounded pill matching settings.png -->
    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_handle_pill" />

    <!-- Header Row: Title & Subtitle + Close Button (X) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/settings_title"
                android:textColor="@color/neo_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/space_mono_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/settings_subtitle"
                android:textColor="@color/neo_ink_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Tactile Square Close Button (X) matching settings.png -->
        <ImageButton
            android:id="@+id/btnSettingsClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_neo_ctrl_btn_square"
            android:contentDescription="@string/close"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_neo" />

    </RelativeLayout>

    <!-- ═══ 1. APPEARANCE SECTION ═══ -->
    <TextView
        android:id="@+id/tagAppearance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_settings_tag"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.08"
        android:paddingStart="9dp"
        android:paddingTop="3.5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3.5dp"
        android:rotation="-2"
        android:text="@string/settings_section_appearance"
        android:textColor="#000000"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <!-- Theme Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_card_white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- Theme Header: Palette Icon + Theme Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_settings_icon_box"
                android:contentDescription="@string/settings_theme_title"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_palette_neo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:includeFontPadding="false"
                    android:text="@string/settings_theme_title"
                    android:textColor="@color/neo_ink"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/space_mono_bold"
                    android:includeFontPadding="false"
                    android:text="@string/settings_theme_modes_desc"
                    android:textColor="@color/neo_ink_muted"
                    android:textSize="10.5sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 3-Segment Mode Pill: LIGHT / DARK / AUTO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_settings_theme_pill">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_segment_active_left"
                    android:fontFamily="@font/space_mono_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/theme_mode_light"
                    android:textAllCaps="true"
                    android:textColor="?attr/neoAccent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_segment_inactive"
                    android:fontFamily="@font/space_mono_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/theme_mode_dark"
                    android:textAllCaps="true"
                    android:textColor="@color/neo_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnThemeAuto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_theme_segment_inactive"
                    android:fontFamily="@font/space_mono_bold"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="@string/theme_mode_auto"
                    android:textAllCaps="true"
                    android:textColor="@color/neo_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- Accent Color Swatches Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- Swatch 1: Neon Lime (#C8F031) with Checkmark -->
            <FrameLayout
                android:id="@+id/btnSwatchLime"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_swatch_lime"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivCheckLime"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_swatch_check_circle"
                    android:padding="3.5dp"
                    android:src="@drawable/ic_check_small_neo" />

            </FrameLayout>

            <!-- Swatch 2: Electric Blue (#2B50E6) -->
            <FrameLayout
                android:id="@+id/btnSwatchBlue"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_swatch_blue"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivCheckBlue"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_swatch_check_circle"
                    android:padding="3.5dp"
                    android:src="@drawable/ic_check_small_neo"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Swatch 3: Burnt Orange (#D9542B) -->
            <FrameLayout
                android:id="@+id/btnSwatchOrange"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_swatch_orange"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivCheckOrange"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_swatch_check_circle"
                    android:padding="3.5dp"
                    android:src="@drawable/ic_check_small_neo"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Swatch 4: Slate Grey (#8C8C8C) -->
            <FrameLayout
                android:id="@+id/btnSwatchGrey"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_swatch_grey"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivCheckGrey"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/bg_swatch_check_circle"
                    android:padding="3.5dp"
                    android:src="@drawable/ic_check_small_neo"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Footer: OPENVOGE v1.0 matching settings.png -->
    <TextView
        android:id="@+id/tvAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.14"
        android:text="OPENVOGE v1.0"
        android:textColor="@color/neo_ink_muted"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
