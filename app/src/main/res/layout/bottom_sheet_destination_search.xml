<?xml version="1.0" encoding="utf-8"?>
<!-- "Where to?" sheet: free-text place search (Photon) + nearest fuel (Overpass) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_openvoge_bottom_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_handle_pill" />

    <!-- Header: title + subtitle + close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnSearchClose"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/map_search_hint"
                android:textColor="@color/neo_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/space_mono_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/map_search_subtitle"
                android:textColor="@color/neo_ink_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSearchClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_neo_ctrl_btn_square"
            android:contentDescription="@string/close"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_neo" />
    </RelativeLayout>

    <!-- Query field: white neo box with hard shadow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_neo_box_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_neo" />

        <EditText
            android:id="@+id/etDestinationQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/space_grotesk_bold"
            android:hint="@string/map_search_input_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text|textCapSentences"
            android:maxLines="1"
            android:textColor="#000000"
            android:textColorHint="#7A7A7A"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Nearest fuel: most stations in OSM have no name, so they can't be found by typing -->
    <LinearLayout
        android:id="@+id/btnNearestFuel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nav_tab_active"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fuel_neo"
            app:tint="?attr/neoOnAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="@string/map_search_nearest_fuel"
            android:textColor="?attr/neoOnAccent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/space_mono_bold"
        android:textColor="@color/neo_ink_muted"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- ═══ RESULTS ═══ -->
    <LinearLayout
        android:id="@+id/groupPlaceResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_settings_tag"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:paddingStart="9dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3.5dp"
            android:rotation="-2"
            android:text="@string/map_search_results"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_card_white"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/layoutPlaceResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</LinearLayout>
