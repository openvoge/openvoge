<?xml version="1.0" encoding="utf-8"?>
<!-- Neo-Brutalist "Connect bike" sheet: saved history (with AUTO bike) + live nearby scan + remember switch -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bikePickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_openvoge_bottom_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_handle_pill" />

    <!-- Header: title + subtitle + close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/bike_picker_title"
                android:textColor="@color/neo_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/space_mono_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/bike_picker_subtitle"
                android:textColor="@color/neo_ink_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBikePickerClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_neo_ctrl_btn_square"
            android:contentDescription="@string/close"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_neo" />
    </RelativeLayout>

    <!-- ═══ SAVED (history; one may be AUTO) ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_settings_tag"
        android:fontFamily="@font/space_mono_bold"
        android:letterSpacing="0.08"
        android:paddingStart="9dp"
        android:paddingTop="3.5dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3.5dp"
        android:rotation="-2"
        android:text="@string/bike_picker_saved"
        android:textColor="#000000"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_card_white"
        android:orientation="vertical"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/layoutSavedBikes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvSavedEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_mono_bold"
            android:padding="18dp"
            android:text="@string/bike_picker_empty_saved"
            android:textColor="@color/neo_ink_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ═══ NEARBY (live scan while the sheet is open) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_tag"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:paddingStart="9dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3.5dp"
            android:rotation="2"
            android:text="@string/bike_picker_nearby"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Live scan indicator: breathing accent dot -->
        <View
            android:id="@+id/viewScanDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/ic_record_neo"
            android:backgroundTint="?attr/neoAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/space_mono_bold"
            android:letterSpacing="0.08"
            android:text="@string/bike_picker_scanning"
            android:textColor="@color/neo_ink_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neo_card_white"
        android:orientation="vertical"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/layoutNearbyBikes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNearbyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_mono_bold"
            android:padding="18dp"
            android:text="@string/bike_picker_empty_nearby"
            android:textColor="@color/neo_ink_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ═══ Remember & auto-connect ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_neo_card_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_settings_icon_box"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bluetooth_neo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/bike_picker_remember_title"
                android:textColor="@color/neo_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/space_mono_bold"
                android:includeFontPadding="false"
                android:text="@string/bike_picker_remember_desc"
                android:textColor="@color/neo_ink_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/switchRememberBike"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_neo_switch_track_off"
            android:clickable="true"
            android:contentDescription="@string/bike_picker_remember_title"
            android:focusable="true">

            <View
                android:id="@+id/switchRememberBikeThumb"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_neo_switch_thumb" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
