<?xml version="1.0" encoding="utf-8"?>
<!-- One route choice under the map: duration big, then distance and arrival time on their own lines
     so three choices still fit side by side -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_route_option_idle"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvRouteOptionTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/space_grotesk_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/neo_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRouteOptionDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_mono_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/neo_ink"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvRouteOptionArrival"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_mono_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/neo_ink"
        android:textSize="10sp" />

</LinearLayout>
