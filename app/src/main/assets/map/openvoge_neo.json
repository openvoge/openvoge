          "get",
          "class"
        ],
        "wood"
      ],
      "paint": {
        "fill-color": "{{wood}}",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          10,
          1
        ]
      }
    },
