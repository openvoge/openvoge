{
  "version": 8,
  "name": "OpenVOGE Neo",
  "metadata": {
    "openvoge:note": "Template: double-brace placeholders are filled by NeoMapStyle.kt for the current theme, accent and language."
  },
  "sources": {
    "openmaptiles": {
